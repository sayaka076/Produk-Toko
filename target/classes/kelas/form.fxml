<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="kelas.controller.FormController"
            stylesheets="@styles/app.css">
    <top>
        <HBox spacing="16" styleClass="header">
            <Label text="Pencatatan Produk Toko" styleClass="title"/>
            <Button text="Lihat Daftar" onAction="#bukaDaftar"/>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true">
            <content>
                <VBox spacing="16" styleClass="page">
                    <VBox spacing="12" styleClass="card">
                        <Label text="Buat produk baru" styleClass="subtitle"/>
                        <Label text="Nama produk"/>
                        <TextField fx:id="namaField" promptText="Contoh: Nasi Goreng Spesial"/>
                        <Label text="Kategori produk"/>
                        <ComboBox fx:id="jenisBox" maxWidth="Infinity"/>
                        <Label text="Kategori: Makanan / Minuman" wrapText="true" styleClass="muted"/>
                        <Label text="Harga produk (Rp)"/>
                        <TextField fx:id="jumlahField" promptText="Contoh: 25000"/>
                        <ImageView fx:id="gambarView" fitWidth="280" fitHeight="160" preserveRatio="true"/>
                        <HBox spacing="10">
                            <Button text="Pilih Gambar" onAction="#pilihGambar"/>
                            <Button text="Hapus Lampiran" onAction="#hapusGambar"/>
                        </HBox>
                        <Label text="Gambar produk opsional PNG/JPG/JPEG maksimal 5 MB." wrapText="true" styleClass="muted"/>
                        <Label text="Periksa kembali data produk sebelum menyimpan." wrapText="true" styleClass="muted"/>
                        <Button text="Simpan dan Lihat Detail" onAction="#simpan" styleClass="button-primary" maxWidth="Infinity"/>
                        <Label fx:id="pesanLabel" wrapText="true" styleClass="error"/>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>